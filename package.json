{
  "name": "normcore",
  "private": true,
  "version": "0.0.0",
  "description": "An assertively basic web framework.",
  "type": "module",
  "style": "./dist/css/normcore.css",
  "scripts": {
    "clean": "rimraf dist",
    "lint": "stylelint src/css",
    "format": "npm run lint -- --fix",
    "build:docs": "eleventy --pathprefix=normcore",
    "prebuild:css": "mkdir -p dist/css",
    "build:css": "lightningcss --minify --bundle --browserslist --sourcemap src/css/*.css --output-dir dist/css",
    "prebuild": "npm run clean",
    "build": "npm run build:docs && npm run build:css",
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "eleventy --serve"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ok-steve/normcore.git"
  },
  "keywords": [
    "css"
  ],
  "author": {
    "name": "Steve Cherry",
    "email": "steve@stevecherry.net",
    "url": "https://stevecherry.net"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ok-steve/normcore/issues"
  },
  "homepage": "https://github.com/ok-steve/normcore#readme",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.8",
    "lightningcss-cli": "^1.33.0",
    "rimraf": "^6.0.1",
    "stylelint": "^16.6.0",
    "stylelint-config-recess-order": "^7.1.0",
    "stylelint-config-standard": "^39.0.0",
    "stylelint-no-unsupported-browser-features": "^8.0.1",
    "stylelint-order": "^8.1.1"
  }
}
